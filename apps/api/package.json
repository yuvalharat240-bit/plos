{
  "name": "@plos/api",
  "version": "0.1.0",
  "private": true,
  "description": "plos backend — NestJS API + worker (ADR D2, D3, D9). Milestone 1 scope: schema bootstrap + RLS only.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev:db": "node scripts/dev-db.js",
    "restore-drill": "node scripts/restore-drill.js",
    "worker": "node dist/worker-main.js",
    "worker:dev": "ts-node src/worker-main.ts",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "test": "jest",
    "test:rls": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json"
  },
  "overrides": {
    "body-parser": "^1.20.8",
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.7.0",
    "@simplewebauthn/server": "^10.0.1",
    "@simplewebauthn/types": "^10.0.0",
    "archiver": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jose": "^5.9.6",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.0",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "cbor": "^9.0.2",
    "cross-env": "^7.0.3",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testTimeout": 60000,
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.spec.json"
      }
    }
  }
}
